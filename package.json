{
  "name": "ffvb-ranking-calendar",
  "version": "1.0.0",
  "description": "Extract data from FFVB and generate ICS calendar files",
  "main": "dist/backend/index.js",
  "scripts": {
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cpy frontend dist",
    "dev": "concurrently \"tsc --watch\" \"nodemon -q dist/backend/server.js\"",
    "start": "node dist/backend/server.js",
    "start:netlify": "netlify dev",
    "deploy": "pnpm run build && netlify deploy --prod"
  },
  "keywords": [
    "ffvb",
    "volleyball",
    "calendar",
    "ics"
  ],
  "author": "Theo Denoyelle",
  "license": "ISC",
  "engines": {
    "node": ">=18.12.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.16",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "cpy-cli": "^5.0.0",
    "netlify-cli": "^23.1.3",
    "nodemon": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "accepts": "^1.3.8",
    "cheerio": "^1.0.0-rc.12",
    "crawler": "^1.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ics": "^3.7.2",
    "serverless-http": "^3.2.0"
  }
}
