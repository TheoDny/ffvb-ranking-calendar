{
    "name": "ffvb-ranking-calendar",
    "version": "1.0.0",
    "description": "Extract data from FFVB and generate ICS calendar files",
    "main": "dist/backend/index.js",
    "scripts": {
        "build": "pnpm run build:backend && pnpm run build:frontend",
        "build:backend": "tsc",
        "build:frontend": "cpy frontend dist",
        "dev": "concurrently \"tsc --watch\" \"nodemon -q dist/backend/server.js\"",
        "start": "node dist/backend/server.js",
        "start:netlify": "netlify dev",
        "deploy": "pnpm run build && netlify deploy --prod",
        "lint": "eslint backend/**/*.ts",
        "lint:fix": "eslint backend/**/*.ts --fix",
        "format": "prettier --write \"backend/**/*.ts\" \"frontend/**/*.{js,html,css}\"",
        "format:check": "prettier --check \"backend/**/*.ts\" \"frontend/**/*.{js,html,css}\""
    },
    "keywords": [
        "ffvb",
        "volleyball",
        "calendar",
        "ics"
    ],
    "author": "Theo Denoyelle",
    "license": "ISC",
    "engines": {
        "node": ">=18.12.0",
        "pnpm": ">=8.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/express": "^4.17.13",
        "@types/express-validator": "^3.0.2",
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "concurrently": "^9.2.1",
        "cpy-cli": "^6.0.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.5.0",
        "netlify-cli": "^23.1.3",
        "nodemon": "^3.1.0",
        "prettier": "^3.6.2",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "cheerio": "^1.1.2",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "ics": "^3.7.2",
        "netlify": "^23.11.0",
        "serverless-http": "^4.0.0",
        "winston": "^3.18.3"
    }
}